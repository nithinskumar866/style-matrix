# Must use the psycopg driver prefix. The database needs the pgvector extension available.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Your Supabase project URL. Used to verify login tokens.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Comma-separated frontend origins allowed to call the API. Set this when deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
